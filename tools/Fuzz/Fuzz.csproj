<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates sentences and types them into the whole app without a screen until something comes out wrong.
       Not part of the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HanYeong\HanYeong.csproj" />
    <!-- The simulated keyboard, text box and IME of the headless app tests. -->
    <Compile Include="..\..\tests\HanYeong.Tests\FakeDesktop.cs" Link="FakeDesktop.cs" />
    <Compile Include="..\..\tests\HanYeong.Tests\ManualContext.cs" Link="ManualContext.cs" />
  </ItemGroup>

</Project>
